# Scraper <-> Server internal API key
INGEST_API_KEY=change-me

# Mobile App <-> Server Bearer token + HMAC-SHA256 signing key
APP_API_TOKEN=change-me-app-token

# Club Admin web login password (optional fallback for /, /devices, /auth)
ADMIN_PASSWORD=change-me-admin-password

# One-time setup token to enroll Android Fingerprint / iPhone FaceID passkeys at /login
# Remove this variable after enrolling your devices to lock down registration.
ADMIN_SETUP_TOKEN=change-me-setup-token

# Optional: explicit WebAuthn RP ID / Origin (defaults to request host/origin)
# WEBAUTHN_RP_ID=eagles.boomhut.dev
# WEBAUTHN_ORIGIN=https://eagles.boomhut.dev

# Optional: explicit secret for signing HttpOnly session cookies
# SESSION_SECRET=change-me-session-secret

# Optional: comma-separated CORS allowlist
# ALLOWED_ORIGINS=https://eaglesrunclub.com,https://www.eaglesrunclub.com

# Optional: path to a custom GPX or JSON route file inside ./data/
# ROUTE_FILE=/app/data/custom.gpx
